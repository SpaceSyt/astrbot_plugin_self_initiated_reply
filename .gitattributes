# 手工部署包（VPS 直投 zip）的导出清单：git archive 只导出 tracked 文件，未跟踪与
# 被 .gitignore 排除的开发物天然不进包，此处再排除对部署无意义的仓库内容。
# 发布命令见 docs/DECISIONS.md「发布产物」。
tests/ export-ignore
scripts/ export-ignore
.github/ export-ignore
assets/ export-ignore
data/ export-ignore
node_modules/ export-ignore
package.json export-ignore
package-lock.json export-ignore
# 构建配置：AstrBot 插件加载只读 metadata.yaml，pyproject 与 wheel 的 exclude
# 列表同属开发侧，不进部署包。
pyproject.toml export-ignore
playwright.config.mjs export-ignore
uv.lock export-ignore
.editorconfig export-ignore
.gitignore export-ignore
.gitattributes export-ignore
